{
  "name": "@srav/mcp-time-server",
  "version": "1.0.0",
  "description": "A minimal MCP server exposing a single tool, for learning MCP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "my-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "client": "node dist/client.js",
    "dev:client": "tsx src/client.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
